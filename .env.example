# Database (PostgreSQL)
# App runtime: use pooler URL if available (e.g. Supabase port 6543 + ?pgbouncer=true)
DATABASE_URL="postgresql://user:password@localhost:5432/solopreneur_os"

# Schema push / migrations: direct connection (Supabase port 5432, not the pooler)
# DIRECT_URL="postgresql://user:password@localhost:5432/solopreneur_os"

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk webhook (Dashboard → Webhooks → signing secret)
# CLERK_WEBHOOK_SECRET=

# OpenAI (required for idea scoring)
OPENAI_API_KEY=
# AI rate limit per user per hour (default 30)
# AI_RATE_LIMIT_PER_HOUR=30
# Optional model overrides
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_MODEL_ADVANCED=gpt-4o

# Optional: GitHub token for repository integration + status checks
# GITHUB_TOKEN=

# GitHub webhook secret (generate: openssl rand -hex 32)
# GITHUB_WEBHOOK_SECRET=

# Vercel (optional — link projects in Build Tracker → Project profile)
# Create token: https://vercel.com/account/tokens
# VERCEL_TOKEN=

# Preview URL template for PR builds ({owner}, {repo}, {pr}, {branch})
# PREVIEW_URL_TEMPLATE=https://{repo}-git-{branch}-{owner}.vercel.app

# Set to "true" to simulate failed builds (test build-breaker blame)
# GITHUB_SIMULATE_BUILD_FAILURE=false

# Generic CI webhook secret (GitHub Actions, Bitrise, GitLab CI → POST /api/ci/webhook)
# CI_WEBHOOK_SECRET=

# Encrypt stored GitHub/Vercel OAuth tokens (required when linking integrations)
# Must be exactly 64 hex chars (32 bytes). Do NOT use base64 or openssl rand -hex 16.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ENCRYPTION_KEY=
# During key rotation, set old key here until all ciphertext is re-encrypted:
# ENCRYPTION_KEY_PREVIOUS=

# Observability (optional)
# SENTRY_DSN=

# Stripe (optional — revenue checkout & webhooks)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Public site origin (webhooks, Stripe redirects). Required in production.
# Local:  http://localhost:3000
# Prod:   https://your-domain.com  (do NOT leave localhost in prod)
# NEXT_PUBLIC_APP_URL=http://localhost:3000
